// ============================================================
// LearnPro Academy — Comprehensive Mock Data
// Realistic, domain-accurate data for Indian coaching industry
// ============================================================

// ---- TYPES ----

export interface Institute {
  id: string;
  name: string;
  slug: string;
  tagline: string;
  description: string;
  logo: string;
  coverImage: string;
  rating: number;
  reviewCount: number;
  location: { city: string; area: string; state: string; lat: number; lng: number };
  exams: string[];
  established: number;
  studentCount: number;
  facultyCount: number;
  branchCount: number;
  passRate: number;
  topperCount: number;
  feeRange: { min: number; max: number };
  features: string[];
  images: string[];
  verified: boolean;
  trending: boolean;
}

export interface Course {
  id: string;
  instituteId: string;
  instituteName: string;
  name: string;
  exam: string;
  description: string;
  duration: string;
  mode: "Online" | "Offline" | "Hybrid";
  subjects: string[];
  feeTotal: number;
  feeMonthly: number;
  batchOptions: BatchOption[];
  syllabus: SyllabusChapter[];
  features: string[];
  rating: number;
  enrolledCount: number;
  image: string;
  sampleLectureUrl: string;
  startDate: string;
  isCrashCourse: boolean;
}

export interface BatchOption {
  id: string;
  name: string;
  timing: string;
  days: string;
  seatsTotal: number;
  seatsFilled: number;
  startDate: string;
  faculty: string[];
}

export interface SyllabusChapter {
  id: string;
  subject: string;
  chapter: string;
  lectures: number;
  completed: number;
  testScheduled: boolean;
}

export interface Faculty {
  id: string;
  name: string;
  avatar: string;
  subject: string;
  qualification: string;
  experience: number;
  rating: number;
  studentsCount: number;
  specialization: string;
  bio: string;
}

export interface Student {
  id: string;
  name: string;
  avatar: string;
  email: string;
  phone: string;
  enrollmentId: string;
  batch: string;
  exam: string;
  branch: string;
  enrollmentDate: string;
  status: "Active" | "Paused" | "Dropped" | "Completed" | "Waitlisted";
  attendance: number;
  avgScore: number;
  feePaid: number;
  feeTotal: number;
  parentName: string;
  parentPhone: string;
  performanceTrend: "up" | "down" | "stable";
  riskLevel: "low" | "medium" | "high";
}

export interface TestResult {
  id: string;
  testName: string;
  type: "Chapter Test" | "Weekly Test" | "Monthly Mock" | "Scholarship Test";
  subject: string;
  date: string;
  totalMarks: number;
  marksObtained: number;
  percentile: number;
  rank: number;
  totalStudents: number;
  timeTaken: number;
  totalTime: number;
  accuracy: number;
  attempted: number;
  totalQuestions: number;
  sectionWise: { section: string; marks: number; total: number; accuracy: number }[];
  negativeMarks: number;
}

export interface ScheduleItem {
  id: string;
  type: "Live Class" | "Recorded" | "Test" | "Doubt Session" | "Assignment Due";
  title: string;
  subject: string;
  faculty: string;
  time: string;
  duration: string;
  batch: string;
  room: string;
  status: "Upcoming" | "Live" | "Completed" | "Cancelled";
  meetLink?: string;
}

export interface Doubt {
  id: string;
  studentName: string;
  studentAvatar: string;
  subject: string;
  chapter: string;
  question: string;
  image?: string;
  status: "Submitted" | "In Progress" | "Resolved";
  createdAt: Date;
  resolvedAt?: Date;
  assignedTo: string;
  priority: "Low" | "Medium" | "High";
}

export interface Lead {
  id: string;
  name: string;
  phone: string;
  email: string;
  exam: string;
  source: "Google Ads" | "Referral" | "Walk-in" | "Website" | "Marketplace" | "Social Media" | "WhatsApp";
  status: "New" | "Contacted" | "Demo Booked" | "Demo Done" | "Enrolled" | "Lost";
  assignedTo: string;
  createdAt: Date;
  lastFollowUp: Date;
  nextFollowUp: Date;
  score: number;
  notes: string;
  lostReason?: string;
}

export interface FeeRecord {
  id: string;
  studentId: string;
  studentName: string;
  batch: string;
  installment: number;
  totalInstallments: number;
  amount: number;
  dueDate: string;
  paidDate?: string;
  status: "Paid" | "Pending" | "Overdue" | "Partially Paid";
  method?: "UPI" | "Card" | "Net Banking" | "Cash" | "EMI";
  receiptNo?: string;
  discount?: { type: string; amount: number };
}

export interface Branch {
  id: string;
  name: string;
  address: string;
  city: string;
  manager: string;
  phone: string;
  studentCount: number;
  facultyCount: number;
  batchCount: number;
  revenue: number;
  collectionRatio: number;
  enrollmentRate: number;
  image: string;
}

export interface Notification {
  id: string;
  type: "class" | "test" | "fee" | "result" | "announcement" | "doubt" | "attendance";
  title: string;
  message: string;
  time: Date;
  read: boolean;
  actionUrl?: string;
}

export interface LectureRecord {
  id: string;
  title: string;
  subject: string;
  chapter: string;
  faculty: string;
  duration: string;
  date: string;
  thumbnail: string;
  watched: "Watched" | "Partially Watched" | "Unwatched";
  progress: number;
  views: number;
}

export interface StudyMaterial {
  id: string;
  title: string;
  type: "PDF Notes" | "Video Short" | "Formula Sheet" | "PYQ Paper" | "DPP" | "Mind Map";
  subject: string;
  chapter: string;
  faculty: string;
  uploadDate: string;
  downloads: number;
  size: string;
  bookmarked: boolean;
}

export interface Assignment {
  id: string;
  title: string;
  subject: string;
  chapter: string;
  faculty: string;
  dueDate: string;
  submittedDate?: string;
  status: "Pending" | "Submitted" | "Graded" | "Late" | "Overdue";
  maxMarks: number;
  marksObtained?: number;
  feedback?: string;
}

